# Aatmi Curtain Studio — AI Configuration
# Brand owners only need ONE API key: OPENROUTER_API_KEY
# Get your key at https://openrouter.ai/keys

# 1. Unified OpenRouter Key (Powers Vision Analysis, Inpainting, and Room Visualization)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# 2. Recommended OpenRouter Model Overrides (Optional — sensible defaults are built-in)
# Stage 1: Vision / Curtain Region Segmentation (Default: google/gemini-2.5-flash)
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Stage 2: Structure-Preserving Fabric Inpainting (Default: black-forest-labs/flux-fill-pro)
# OPENROUTER_INPAINT_MODEL=black-forest-labs/flux-fill-pro

# Stage 3: Real-Room Architectural Visualization (Default: google/gemini-3-pro-image)
# OPENROUTER_ROOM_VIZ_MODEL=google/gemini-3-pro-image

# 3. Direct Provider Fallbacks (Optional — only needed if bypassing OpenRouter)
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# REPLICATE_API_TOKEN=r8_...
