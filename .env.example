# Aatmi Curtain Studio — AI Configuration
# Brand owners only need ONE API key: OPENROUTER_API_KEY
# Get your key at https://openrouter.ai/keys

# 1. Unified OpenRouter Key (Powers Vision analysis, render generation, grading and room staging)
OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here

# 2. Model overrides (optional — defaults are built in)
# Image generation for renders and room staging (default: openai/gpt-5.4-image-2; alternative google/gemini-3-pro-image)
# OPENROUTER_ROOM_VIZ_MODEL=openai/gpt-5.4-image-2

# Vision model for zone analysis, window detection and render grading (default: google/gemini-2.5-flash)
# OPENROUTER_VISION_MODEL=google/gemini-2.5-flash

# Gemini image model, used only for the generate fallback when no OpenRouter key resolves
# (default: gemini-3.1-flash-image)
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# 3. Direct Provider Fallbacks (Optional — only needed if bypassing OpenRouter)
# GEMINI_API_KEY=AIzaSy...
# OPENAI_API_KEY=sk-...
# REPLICATE_API_TOKEN=r8_...

# 4. Accounts (built-in). The first admin is created from these when the database has no admin yet.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# ADMIN_NAME=Admin
# The admin's own brand, created on first start so the admin can design too (default: Aatmi)
# ADMIN_BRAND=Aatmi
# Where the SQLite file and stored images live (default ./data)
# DATA_DIR=./data
# Public URL used in invite links (default: the request's host)
# APP_URL=https://studio.example.com
