# Server Port
PORT=3000

# Google Gemini API Key (Required for AI region detection & photorealistic curtain synthesis)
GEMINI_API_KEY=

# Optional: Switch Gemini Image generation model (defaults to gemini-3.1-flash-image)
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional Alternative AI Providers (Configurable in Settings modal)
OPENAI_API_KEY=
REPLICATE_API_TOKEN=
STABILITY_API_KEY=
